# lombok.config
# Impede que o Lombok procure outras configurações acima da raiz
config.stopBubbling = true

# Adiciona @Generated para que ferramentas como JaCoCo ignorem o código gerado nos testes
lombok.addLombokGeneratedAnnotation = true

# Força o uso de loggers específicos (ex: Slf4j)
lombok.log.fieldName = log

# Evita o uso de @Data em entidades JPA (gera hashcode/equals instáveis)
# Prefira @Getter, @Setter e @RequiredArgsConstructor separadamente
