<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>

    <!-- ========================================================== -->
    <!-- TESTES - Menos restrições                                  -->
    <!-- ========================================================== -->
    <suppress checks="MethodLength|CyclomaticComplexity|MagicNumber|NPathComplexity|ReturnCount|VisibilityModifier"
              files=".*[\\/]src[\\/](test)[\\/].*"/>

    <suppress checks="MagicNumber"
              files=".*[\\/]src[\\/](test)[\\/].*"/>

    <suppress checks="MethodName"
              files=".*[\\/]src[\\/](test)[\\/].*"/>

    <suppress checks="MultipleStringLiterals"
              files=".*[\\/]src[\\/](test)[\\/].*"/>

    <!-- ========================================================== -->
    <!-- DTOS - Permite campos compactos                           -->
    <!-- ========================================================== -->
    <suppress checks="MagicNumber|FinalClass|VisibilityModifier|HiddenField|HideUtilityClassConstructor|EmptyLineSeparator"
              files=".*Dto\.java|.*DTO\.java|.*Request\.java|.*Response\.java|.*Record\.java"/>

    <!-- ========================================================== -->
    <!-- ENTITIES - JPA                                            -->
    <!-- ========================================================== -->
    <suppress checks="MagicNumber|VisibilityModifier|FinalClass|HideUtilityClassConstructor|EmptyLineSeparator"
              files=".*Entity\.java"/>

    <!-- ========================================================== -->
    <!-- ENUMS                                                     -->
    <!-- ========================================================== -->
    <suppress checks="MethodLength|MagicNumber|HideUtilityClassConstructor|EmptyLineSeparator"
              files=".*Enum\.java"/>

    <!-- ========================================================== -->
    <!-- CONSTANTS                                                  -->
    <!-- ========================================================== -->
    <suppress checks="MagicNumber|VisibilityModifier|HideUtilityClassConstructor|EmptyLineSeparator"
              files=".*Constants\.java|.*Const\.java"/>

    <!-- ========================================================== -->
    <!-- CONFIGURATIONS                                             -->
    <!-- ========================================================== -->
    <suppress checks="MagicNumber|MethodLength|HideUtilityClassConstructor|EmptyLineSeparator"
              files=".*Config\.java|.*Configuration\.java|.*Properties\.java"/>

    <!-- ========================================================== -->
    <!-- CONTROLLERS - APIs REST                                   -->
    <!-- ========================================================== -->
    <suppress checks="MagicNumber|HideUtilityClassConstructor|VisibilityModifier|EmptyLineSeparator"
              files=".*Controller\.java"/>


    <!-- ========================================================== -->
    <!-- UTILITY CLASSES - Permite construtores                   -->
    <!-- ========================================================== -->
    <suppress checks="HideUtilityClassConstructor|EmptyLineSeparator"
              files=".*Utils\.java|.*Util\.java|.*Helper\.java|.*Factory\.java|.*Builder\.java"/>

    <!-- ========================================================== -->
    <!-- MAIN APPLICATION                                           -->
    <!-- ========================================================== -->
    <suppress checks="HideUtilityClassConstructor|MethodLength|CyclomaticComplexity|MagicNumber|ImportOrder"
              files=".*Application\.java"/>

    <!-- ========================================================== -->
    <!-- TARGET - Ignorar tudo                                     -->
    <!-- ========================================================== -->
    <suppress files="[\\/]target[\\/].*" checks=".*"/>

</suppressions>
