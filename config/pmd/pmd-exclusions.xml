<?xml version="1.0"?>
<suppressions xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0
                                  https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <!-- ========================================================== -->
    <!-- 1. TESTES                                                  -->
    <!-- ========================================================== -->
    <suppress checks="CyclomaticComplexity|NPathComplexity|NcssCount|GodClass|CognitiveComplexity|TooManyMethods|TooManyFields|MethodArgumentCouldBeFinal|LocalVariableCouldBeFinal"
              files=".*Test\.java|.*IT\.java"/>

    <!-- ========================================================== -->
    <!-- 2. CONTROLLERS (APIs REST)                                -->
    <!-- ========================================================== -->
    <suppress checks="MethodArgumentCouldBeFinal|LocalVariableCouldBeFinal|ShortVariable|AvoidCatchingGenericException"
              files=".*Controller\.java"/>

    <!-- ========================================================== -->
    <!-- 3. SERVICES                                                -->
    <!-- ========================================================== -->
    <suppress checks="MethodArgumentCouldBeFinal|LocalVariableCouldBeFinal|ShortVariable"
              files=".*Service\.java"/>

    <!-- ========================================================== -->
    <!-- 4. DTOS/REQUESTS/RESPONSES                                 -->
    <!-- ========================================================== -->
    <suppress checks="TooManyFields|TooManyMethods|DataClass|ShortVariable|ImmutableField|FinalFieldCouldBeStatic|FieldNamingConventions|MethodArgumentCouldBeFinal|LocalVariableCouldBeFinal|MissingSerialVersionUID"
              files=".*Dto\.java|.*DTO\.java|.*Request\.java|.*Response\.java"/>

    <!-- ========================================================== -->
    <!-- 5. ENTITIES                                                -->
    <!-- ========================================================== -->
    <suppress checks="TooManyFields|ImmutableField|DataClass|ShortVariable|MethodArgumentCouldBeFinal|LocalVariableCouldBeFinal"
              files=".*Entity\.java"/>

    <!-- ========================================================== -->
    <!-- 6. ENUMS                                                   -->
    <!-- ========================================================== -->
    <suppress checks="TooManyMethods|TooManyFields|ShortVariable|MethodArgumentCouldBeFinal|LocalVariableCouldBeFinal"
              files=".*Enum\.java"/>

    <!-- ========================================================== -->
    <!-- 7. CONSTANTS                                               -->
    <!-- ========================================================== -->
    <suppress checks="AvoidDuplicateLiterals|TooManyFields|ShortVariable|MethodArgumentCouldBeFinal|LocalVariableCouldBeFinal"
              files=".*Constants\.java|.*Const\.java"/>

    <!-- ========================================================== -->
    <!-- 8. CONFIGURATIONS                                          -->
    <!-- ========================================================== -->
    <suppress checks="TooManyMethods|TooManyFields|ImmutableField|FinalFieldCouldBeStatic|MethodArgumentCouldBeFinal|LocalVariableCouldBeFinal"
              files=".*Config\.java|.*Configuration\.java|.*Properties\.java"/>

    <!-- ========================================================== -->
    <!-- 9. MAPPER                                                  -->
    <!-- ========================================================== -->
    <suppress checks="TooManyMethods|TooManyFields|ShortVariable|MethodArgumentCouldBeFinal|LocalVariableCouldBeFinal"
              files=".*Mapper\.java"/>

    <!-- ========================================================== -->
    <!-- 10. MAIN APPLICATION                                       -->
    <!-- ========================================================== -->
    <suppress checks="CyclomaticComplexity|NPathComplexity|CognitiveComplexity|MethodArgumentCouldBeFinal|LocalVariableCouldBeFinal"
              files=".*Application\.java"/>

    <!-- ========================================================== -->
    <!-- 11. LOGGER - Permissão para campos de logger              -->
    <!-- ========================================================== -->
    <suppress checks="MoreThanOneLogger|FieldNamingConventions"
              files=".*"/>

    <!-- ========================================================== -->
    <!-- 12. RECURSOS E STREAMS - Exceções para try-with-resources -->
    <!-- ========================================================== -->
    <suppress checks="CloseResource|UseTryWithResources"
              files=".*Test\.java|.*IT\.java"/>

    <!-- ========================================================== -->
    <!-- 13. EXCEÇÕES - Permitir em casos específicos              -->
    <!-- ========================================================== -->
    <suppress checks="AvoidCatchingGenericException"
              files=".*ExceptionHandler\.java|.*GlobalExceptionHandler\.java|.*ErrorHandler\.java"/>

    <!-- ========================================================== -->
    <!-- 14. REPOSITORIES                                           -->
    <!-- ========================================================== -->
    <suppress checks="MethodArgumentCouldBeFinal|LocalVariableCouldBeFinal|ShortVariable|TooManyMethods"
              files=".*Repository\.java"/>

    <!-- ========================================================== -->
    <!-- 15. UTILITIES                                              -->
    <!-- ========================================================== -->
    <suppress checks="MethodArgumentCouldBeFinal|LocalVariableCouldBeFinal|ShortVariable|TooManyMethods"
              files=".*Utils\.java|.*Util\.java|.*Helper\.java|.*Builder\.java|.*Factory\.java"/>

</suppressions>